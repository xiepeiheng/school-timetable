[Unit]
Description=school-timetable API (Django + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/opt/zhangyahan/school-timetable/backend

# config/settings.py reads .env.${ENV}; .env.production is generated by deploy.sh.
Environment=ENV=production
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/zhangyahan/school-timetable/backend/.venv/bin/gunicorn -c gunicorn_conf.py config.wsgi:application

Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
