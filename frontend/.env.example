# Copy this file to .env.development or .env.production

# Vite base path — "/" for root, "/sub-path/" for sub-directory deployment
VITE_BASE=/

# API Base URL — backend API endpoint
VITE_API_BASE_URL=http://127.0.0.1:8001/api

# 本地开发时 vite 代理的后端地址（仅 dev server 使用）
VITE_DEV_PROXY=http://127.0.0.1:8001
