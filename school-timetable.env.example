# === Backend ===
SECRET_KEY=generate-a-random-secret-key
ALLOWED_HOSTS=xph.silyahuukou.cn,82.156.209.232
CORS_ALLOWED_ORIGINS=http://xph.silyahuukou.cn

# === Frontend ===
VITE_BASE=/school-timetable/
VITE_API_BASE_URL=http://xph.silyahuukou.cn/school-timetable/api

